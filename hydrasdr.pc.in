prefix=${pcfiledir}/@HYDRA_PC_TO_PREFIX@
exec_prefix=${prefix}
libdir=${pcfiledir}/..
includedir=${pcfiledir}/@HYDRA_PC_TO_INCLUDE@

Name: hydrasdr
Description: Userland Wi-Fi I/Q receiver with original device firmware
Version: @PROJECT_VERSION@
Libs: -L${libdir} -lhydrasdr
Libs.private: -lpthread
Requires.private: libusb-1.0
Cflags: -I${includedir}
